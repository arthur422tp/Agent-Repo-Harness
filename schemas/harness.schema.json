{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-repo-harness.local/schemas/harness.schema.json",
  "title": "Agent-Repo-Harness configuration",
  "type": "object",
  "$defs": {
    "verificationCommand": {
      "type": "object",
      "required": ["name", "command"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verificationProfile": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verificationCommand" }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["name", "version", "mode", "paths", "scripts", "verification"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "mode": { "type": "string" },
    "paths": {
      "type": "object",
      "required": ["agent_map", "handoff", "task_state"],
      "properties": {
        "agent_map": { "type": "string" },
        "handoff": { "type": "string" },
        "task_state": { "type": "string" }
      },
      "additionalProperties": true
    },
    "scripts": {
      "type": "object",
      "required": ["preflight", "finish", "verify", "check_policy", "check_scope"],
      "additionalProperties": { "type": "string" }
    },
    "verification": {
      "type": "object",
      "required": ["final_gate_command"],
      "properties": {
        "final_gate_command": { "type": "string" },
        "allow_unverified_completion": { "type": "boolean" },
        "required": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationCommand" }
        },
        "profiles": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "additionalProperties": { "$ref": "#/$defs/verificationProfile" }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "strict_refs": { "type": "boolean", "default": false },
        "allow_text_only_evidence": { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "properties": {
        "resource_limits": {
          "type": "object",
          "properties": {
            "max_finish_seconds": { "type": "integer", "minimum": 0 },
            "max_changed_files": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "runner": { "type": "string", "enum": ["docker", "podman"] },
        "mode": { "type": "string", "enum": ["verification"] },
        "command": { "type": "string" },
        "workspace": {
          "type": "object",
          "properties": {
            "strategy": { "type": "string", "enum": ["copy"] }
          },
          "additionalProperties": false
        },
        "network": { "type": "string", "enum": ["disabled", "host"] },
        "env": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "resource_limits": {
          "type": "object",
          "properties": {
            "cpus": { "type": "string" },
            "memory": { "type": "string" },
            "timeout_seconds": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "evidence_dir": { "type": "string" },
        "checks": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
