{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-repo-harness.local/schemas/acceptance.schema.json",
  "title": "Agent-Repo-Harness acceptance evidence",
  "type": "object",
  "required": ["acceptance"],
  "properties": {
    "acceptance": {
      "type": "object",
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "description": "Acceptance criteria. Criterion id values must be unique; check-acceptance.sh enforces id uniqueness because standard JSON Schema cannot express uniqueness by one object member without extensions.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "description", "met"],
            "properties": {
              "id": { "type": "string", "pattern": "\\S" },
              "description": { "type": "string", "pattern": "\\S" },
              "met": { "const": true },
              "evidence": { "type": "string" },
              "verification": { "type": "string" },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "evidence-ref.schema.json"
                }
              }
            },
            "additionalProperties": true,
            "anyOf": [
              {
                "required": ["evidence"],
                "properties": {
                  "evidence": { "type": "string", "pattern": "\\S" }
                }
              },
              {
                "required": ["verification"],
                "properties": {
                  "verification": { "type": "string", "pattern": "\\S" }
                }
              },
              {
                "required": ["evidence_refs"],
                "properties": {
                  "evidence_refs": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
