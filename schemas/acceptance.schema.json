{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-repo-harness.local/schemas/acceptance.schema.json",
  "title": "Agent-Repo-Harness acceptance evidence",
  "type": "object",
  "required": ["acceptance"],
  "properties": {
    "acceptance": {
      "type": "object",
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "description", "met"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "met": { "type": "boolean" },
              "evidence": { "type": "string" },
              "verification": { "type": "string" }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": ["evidence"],
                "properties": {
                  "evidence": { "type": "string", "minLength": 1 }
                }
              },
              {
                "required": ["verification"],
                "properties": {
                  "verification": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
